# Project defaults. `idf.py build` generates sdkconfig from this file;
# delete sdkconfig to re-apply after editing.

# ---- Board (from the Waveshare example) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- Console on the USB port, so UART pins 43/44 are free for the sensor MCU ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- BSP: return errors instead of aborting (e.g. no SD card) ----
# CONFIG_BSP_ERROR_CHECK is not set
CONFIG_BSP_SPIFFS_FORMAT_ON_MOUNT_FAIL=y
CONFIG_BSP_SPIFFS_MAX_FILES=4

# ---- Display memory ----
# The BSP allocates the LVGL draw buffer with plain malloc (lands in PSRAM),
# so every SPI flush needs a DMA bounce buffer of the same size in internal
# RAM. At the default 100 lines (82 KB) that allocation failed once BLE was
# added. 40 lines = 33 KB, and more internal RAM is kept back for DMA.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=40
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ---- SD card: long file names for gw_YYYYMMDD.csv ----
CONFIG_FATFS_LFN_HEAP=y

# ---- Bluetooth LE (NimBLE, peripheral only) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ---- LVGL ----
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_THEME_DEFAULT_DARK=y
